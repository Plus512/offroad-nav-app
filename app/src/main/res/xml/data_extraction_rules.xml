<?xml version="1.0" encoding="utf-8"?>
<!--
    CompassApp Data Extraction Rules — Billing Security
    Excludes billing/subscription data from cloud backup and device transfer
    to prevent trial state manipulation across devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="subscription_prefs.xml"/>
        <exclude domain="sharedpref" path="subscription_prefs.xml.bak"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="subscription_prefs.xml"/>
        <exclude domain="sharedpref" path="subscription_prefs.xml.bak"/>
    </device-transfer>
</data-extraction-rules>