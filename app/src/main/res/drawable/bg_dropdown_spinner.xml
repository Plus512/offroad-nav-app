<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Rounded Background shape -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F7F1E6" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#A0876A" />
        </shape>
    </item>
    <!-- Dropdown Chevron/Arrow positioned on the left side for RTL support -->
    <item
        android:drawable="@android:drawable/arrow_down_float"
        android:gravity="left|center_vertical"
        android:left="12dp"
        android:right="12dp" />
</layer-list>
