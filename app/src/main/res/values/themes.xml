<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ********** تعريف الألوان ********** -->
            <!-- أحمر وردي للمفضلة -->

    <!-- ********** ثيمات التطبيق الأساسية ********** -->
    <style name="Base.Theme.CompassApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.CompassApp" parent="Base.Theme.CompassApp" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Make the system splash transparent to avoid dual-splash flashes -->
        <item name="windowSplashScreenBackground">@android:color/transparent</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.CustomSplash</item>
    </style>

    <style name="Theme.CustomSplash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- ********** أشكال ومكونات UI ********** -->
    <style name="CircularShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircleImageStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 2026-11-26: طابع صحراوي موحد (خلفية داكنة + نص أخضر زاهٍ + زر إلغاء/خروج ذهبي)، بدل
         الخلفية البيجية المسطحة السابقة — تطبيق موحد على كل حوار يستخدم هذا الـstyle (قائمة
         خيارات عنصر المفضلة حاليًا)، كما طلب المستخدم. -->
    <style name="CustomAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/dialog_background</item>
        <item name="android:textColorPrimary">@color/dialog_title_color</item>
        <item name="android:listMenuViewStyle">@style/CustomAlertDialogList</item>
        <item name="android:textSize">@dimen/text_size_22sp</item> <!-- حجم أكبر للعنوان والنصوص -->
        <item name="colorAccent">@color/dialog_negative_text</item>
        <item name="android:windowBackground">@color/dialog_background</item>
    </style>

    <style name="CustomAlertDialogList" parent="Widget.AppCompat.ListView">
        <item name="android:textColor">@color/dialog_item_text</item>
        <item name="android:textSize">@dimen/text_size_22sp</item> <!-- حجم أكبر لعناصر القائمة -->
    </style>
    <style name="MyTabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">22dp</item>  <!-- غيّري الرقم للحجم اللي يعجبك -->
        <item name="android:textAllCaps">false</item> <!-- اختياري لو مش عايزة الحروف كلها كابيتال -->
        <item name="android:textColor">#5B4630</item> <!-- نفس اللون اللي عندك -->
        <item name="android:textStyle">bold</item> <!-- نفس اللون اللي عندك -->
    </style>


</resources>