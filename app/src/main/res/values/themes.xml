<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ********** تعريف الألوان ********** -->
            <!-- أحمر وردي للمفضلة -->

    <!-- ********** ثيمات التطبيق الأساسية ********** -->
    <style name="Base.Theme.CompassApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.CompassApp" parent="Base.Theme.CompassApp" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Make the system splash transparent to avoid dual-splash flashes -->
        <item name="windowSplashScreenBackground">@android:color/transparent</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.CustomSplash</item>
    </style>

    <style name="Theme.CustomSplash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- ********** أشكال ومكونات UI ********** -->
    <style name="CircularShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircleImageStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">@color/dialog_background</item>
        <item name="android:textColorPrimary">@color/dialog_title_color</item>
        <item name="android:listMenuViewStyle">@style/CustomAlertDialogList</item>
        <item name="android:textSize">@dimen/text_size_22sp</item> <!-- حجم أكبر للعنوان والنصوص -->
    </style>

    <style name="CustomAlertDialogList" parent="Widget.AppCompat.ListView">
        <item name="android:textColor">@color/dialog_item_text</item>
        <item name="android:textSize">@dimen/text_size_22sp</item> <!-- حجم أكبر لعناصر القائمة -->
    </style>
    <style name="MyTabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">22dp</item>  <!-- غيّري الرقم للحجم اللي يعجبك -->
        <item name="android:textAllCaps">false</item> <!-- اختياري لو مش عايزة الحروف كلها كابيتال -->
        <item name="android:textColor">#5B4630</item> <!-- نفس اللون اللي عندك -->
        <item name="android:textStyle">bold</item> <!-- نفس اللون اللي عندك -->
    </style>

    <!-- ********** ثيمات شاشة دليل البر القديمة (legacymap.MainActivity/SettingsActivity) ********** -->
    <style name="Theme.DalilAlBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/desert_brown</item>
        <item name="colorPrimaryVariant">@color/desert_brown</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sand_bg</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/desert_brown</item>
    </style>

    <style name="Theme.DalilAlBar.NeonDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorOnPrimary">@color/neon_bg</item>
        <item name="colorSurface">@color/neon_card_bg</item>
        <item name="colorOnSurface">@color/neon_green</item>
        <item name="android:textColorPrimary">@color/neon_green</item>
        <item name="android:textColorSecondary">@color/neon_green_dim</item>
        <item name="android:background">@color/neon_card_bg</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.DalilAlBar.NeonDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.DalilAlBar.NeonDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.DalilAlBar.NeonDialogButton</item>
        <item name="android:textColorAlertDialogListItem">@color/neon_green</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.DalilAlBar.NeonDialogButton.Framework</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.DalilAlBar.NeonDialogButton.Framework</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/Widget.DalilAlBar.NeonDialogButton.Framework</item>
    </style>

    <style name="Widget.DalilAlBar.NeonDialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/neon_green_bright</item>
        <item name="fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.DalilAlBar.NeonDialogButton.Framework" parent="@android:style/Widget.Holo.Button.Borderless.Small">
        <item name="android:textColor">@color/neon_green_bright</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DalilAlBar.NeonDigital" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/neon_green</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:shadowColor">#8039FF6A</item>
        <item name="android:shadowRadius">6</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
    </style>

</resources>