<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_welcome_dialog_card"
    android:layout_margin="24dp"
    android:padding="20dp"
    android:layoutDirection="rtl">

    <!-- Golden Compass Logo at the top -->
    <ImageView
        android:id="@+id/imgWelcomeLogo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_compass_paywall"
        android:tint="#E5A93B"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Compass Logo" />

    <!-- Title -->
    <TextView
        android:id="@+id/txtWelcomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مرحباً بك في قارمن البر!"
        android:textColor="#3E2723"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/imgWelcomeLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Body Message -->
    <TextView
        android:id="@+id/txtWelcomeMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="يمكنك تجربة جميع ميزات قارمن البر مجاناً لمدة 3 أيام.\n\nبعد انتهاء الفترة التجريبية، يمكنك تفعيل النسخة الكاملة."
        android:textColor="#5B4630"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/txtWelcomeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="300dp" />

    <!-- Horizontal Buttons Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtWelcomeMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Continue Button (Plain Text) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinue"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="متابعة"
            android:textColor="#5B4630"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textAllCaps="false" />

        <!-- Spacer -->
        <View
            android:layout_width="20dp"
            android:layout_height="1dp" />

        <!-- Activate Now Button (Dark Brown Pill) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnActivateNow"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_welcome_dialog_btn"
            android:text="تفعيل الآن"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textAllCaps="false" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
