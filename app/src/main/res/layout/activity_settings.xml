<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/neon_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/manage_maps_title"
        android:textAppearance="@style/TextAppearance.DalilAlBar.NeonDigital"
        android:textSize="24sp"
        android:padding="16dp" />

    <!-- تبويبان فقط: خريطة (بلاطات العرض) وطرق سيارة (بيانات Overpass المحفوظة محلياً) — وليس
         أربعة تبويبات كما في «الدليلة بلس» (تضاريس وثلاثي الأبعاد غير موجودين فعلياً في «الدليلة 2»،
         فلا نضع تبويباً لميزة غير موجودة حقاً في التطبيق). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/tabMapTiles"
            style="@style/Widget.DalilAlBar.NeonDialogButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/tab_map_tiles" />

        <Button
            android:id="@+id/tabRoadNetwork"
            style="@style/Widget.DalilAlBar.NeonDialogButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/tab_road_network" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/regionCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp" />

    </ScrollView>
</LinearLayout>
