<?xml version="1.0" encoding="utf-8"?>
<!--
    شاشة التوجيه بخانتين (من هنا/إلى هنا) — نقل حرفي لبنية شاشة PoiBottomSheet في تطبيق «خرائط
    الصحراء الدليلة» (Compose) إلى XML تقليدي يطابق أسلوب دليل البر نفسه (نفس الألوان النيون
    الخضراء ونفس بطاقات bg_neon_card المستخدمة في شاشة الإعدادات)، بدل استيراد مكتبة Compose
    كاملة لأجل شاشة واحدة فقط — قرار اتُّخذ صراحة بعد عرضه على المستخدم ("افعل الأسهل والمنطقي").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/neon_bg"
    android:padding="16dp">

    <!-- صف الرأس: اسم/إحداثيات الوجهة + سهم مصغّر حي يشير للوجهة + أزرار حفظ/نسخ/مشاركة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPoiTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/neon_green"
            android:maxLines="1"
            android:ellipsize="end" />

        <com.alruwaili.garminalbarr.legacymap.CompassArrowView
            android:id="@+id/miniArrow"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnPoiSave"
            style="@style/Widget.DalilAlBar.NeonDialogButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/save_location" />

        <Button
            android:id="@+id/btnPoiCopy"
            style="@style/Widget.DalilAlBar.NeonDialogButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_copy" />

        <Button
            android:id="@+id/btnPoiShare"
            style="@style/Widget.DalilAlBar.NeonDialogButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_share" />
    </LinearLayout>

    <!-- بطاقة الخانتين: من هنا (الانطلاق) / إلى هنا (الوصول)، مع زر تبديل بينهما -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_neon_card"
        android:padding="12dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/slot_origin_label"
                android:textSize="11sp"
                android:textColor="@color/neon_green_dim" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvOriginTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textColor="@color/neon_green"
                android:maxLines="1"
                android:ellipsize="end" />
            <Button
                android:id="@+id/btnOriginChange"
                style="@style/Widget.DalilAlBar.NeonDialogButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_change" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSwapSlots"
            style="@style/Widget.DalilAlBar.NeonDialogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/action_swap" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/slot_destination_label"
                android:textSize="11sp"
                android:textColor="@color/neon_green_dim" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvDestinationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textColor="@color/neon_green"
                android:maxLines="1"
                android:ellipsize="end" />
            <Button
                android:id="@+id/btnDestinationChange"
                style="@style/Widget.DalilAlBar.NeonDialogButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_change" />
        </LinearLayout>
    </LinearLayout>

    <!-- بطاقة الاتجاه (الجهة + الدرجة)، تتحدَّث حيّاً مع البوصلة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_neon_card"
        android:padding="10dp"
        android:layout_marginTop="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bearing_label"
            android:textSize="11sp"
            android:textColor="@color/neon_green_dim" />
        <TextView
            android:id="@+id/tvBearingValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/neon_green" />
    </LinearLayout>

    <Button
        android:id="@+id/btnNavStraight"
        style="@style/Widget.DalilAlBar.NeonDialogButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnNavCar"
        style="@style/Widget.DalilAlBar.NeonDialogButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

</LinearLayout>
