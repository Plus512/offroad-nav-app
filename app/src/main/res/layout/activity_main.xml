<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/desert_brown"
        android:textColor="@color/white"
        android:padding="8dp"
        android:text="@string/locating"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="RtlHardcoded" />

    <TextView
        android:id="@+id/attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#88000000"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:padding="4dp"
        android:text="@string/map_attribution"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- زر القائمة/الإعدادات أسفل يسار الشاشة. هامش سفلي أكبر من المعتاد (٤٠dp) كي لا يتداخل مع
         شريط إسناد الخريطة (attribution) الملاصق لحافة الشاشة السفلية في نفس الزاوية. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="40dp"
        android:contentDescription="@string/menu_settings"
        app:srcCompat="@drawable/ic_menu_hamburger"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        tools:ignore="RtlHardcoded" />

    <!-- زر البحث عن موقع بالاسم -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="110dp"
        android:contentDescription="@string/search_title"
        app:srcCompat="@android:drawable/ic_menu_search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        tools:ignore="RtlHardcoded" />

    <!-- زر المحفوظات (مواقع محفوظة + مسارات مسجَّلة) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSavedItems"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="180dp"
        android:contentDescription="@string/saved_items_title"
        app:srcCompat="@android:drawable/ic_menu_myplaces"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        tools:ignore="RtlHardcoded" />

    <!-- زر قياس المسافة على يمين الشاشة (كما طُلب تحديداً) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMeasure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginTop="166dp"
        android:contentDescription="@string/measure_distance"
        app:srcCompat="@android:drawable/ic_menu_directions"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:ignore="RtlHardcoded" />

    <!-- شارة نصية تعرض المسافة الحيّة أثناء استخدام أداة القياس؛ مخفية افتراضياً. -->
    <TextView
        android:id="@+id/tvMeasureDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="178dp"
        android:layout_marginEnd="86dp"
        android:background="#CC000000"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/neon_green"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/fabMeasure"
        tools:ignore="RtlHardcoded" />

    <!-- زر إنهاء الرحلة النشطة: مخفي افتراضياً، يظهر فقط بعد اختيار وجهة وبدء الملاحة. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabEndTrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:contentDescription="@string/end_trip"
        app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        tools:ignore="RtlHardcoded" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabLocate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="110dp"
        android:contentDescription="@string/locating"
        app:srcCompat="@android:drawable/ic_menu_mylocation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:ignore="RtlHardcoded" />

    <!-- بوصلة مخصّصة أعلى يمين الشاشة: تحل محل بوصلة المكتبة الجاهزة لأنها تحتاج التحكم الكامل
         بزاويتها (شمال افتراضياً، أو اتجاه الوجهة المختارة فعلياً) وبحدث ضغط خاص بها. -->
    <com.alruwaili.dalilalbar.CompassArrowView
        android:id="@+id/compassArrow"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:contentDescription="@string/compass_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:ignore="RtlHardcoded" />

    <!-- أيقونة تسجيل المسار على يمين الشاشة: تبدأ بأيقونة "بدء تسجيل" واضحة، وتتحول عند الضغط إلى
         أيقونة إيقاف حمراء واضحة، مع مؤشر نصي وامض بجانبها طوال فترة التسجيل. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabTrackRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginTop="96dp"
        android:contentDescription="@string/track_record"
        app:srcCompat="@drawable/ic_track_start"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:ignore="RtlHardcoded" />

    <TextView
        android:id="@+id/tvRecordingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="108dp"
        android:layout_marginEnd="86dp"
        android:background="#CC000000"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/recording_in_progress"
        android:textColor="#FF3B30"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/fabTrackRecord"
        tools:ignore="RtlHardcoded" />

    <!-- لوحة البوصلة السفلية لوضع الشاشة المنقسمة؛ مخفية افتراضياً، تظهر عند الضغط على سهم البوصلة
         بعد اختيار وجهة. تُغطّي النصف السفلي من الشاشة فوق الخريطة (التي تبقى كاملة خلفها). -->
    <com.alruwaili.dalilalbar.CompassPanelView
        android:id="@+id/compassPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- زر رجوع/إغلاق صريح داخل لوحة البوصلة نفسها (أعلى يسارها)، بدل الاعتماد فقط على إعادة الضغط
         على سهم البوصلة العلوي. مخفي/ظاهر بنفس حالة ظهور اللوحة. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCloseCompassPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:contentDescription="@string/close_compass_panel"
        app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintTop_toTopOf="@id/compassPanel"
        app:layout_constraintLeft_toLeftOf="@id/compassPanel"
        tools:ignore="RtlHardcoded" />

    <!-- شريط ملاحة سفلي نحيل بخط نيون أخضر (كما وصف المستخدم تحديداً من تطبيقه الآخر): يظهر تلقائياً
         فور اختيار "خط مستقيم" أو "سيارة" (بلا حاجة لضغط يدوي على البوصلة)، ويبقى في أسفل الشاشة طوال
         الملاحة يعرض اسم الهدف والمسافة المتبقية والسرعة الحالية، ويُخفى تلقائياً عند إنهاء الرحلة. -->
    <TextView
        android:id="@+id/navInfoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/neon_card_bg"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/neon_green"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="RtlHardcoded" />

    <!-- شريط البحث العلوي (يحل محل النافذة المنبثقة في وسط الشاشة كما طلب المستخدم تحديداً):
         شريط مستطيل ملاصق لأعلى الشاشة، مخفي افتراضياً، يظهر عند الضغط على زر البحث. -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/neon_card_bg"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:textColor="@color/neon_green"
            android:textColorHint="@color/neon_green_dim"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btnCloseSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:padding="8dp"
            app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@android:string/cancel" />
    </LinearLayout>

    <!-- القائمة المنسدلة الحيّة لنتائج البحث أثناء الكتابة، تظهر أسفل الشريط مباشرة. -->
    <ListView
        android:id="@+id/lvSearchResults"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="360dp"
        android:background="@color/neon_card_bg"
        android:divider="#331DE9B6"
        android:dividerHeight="1dp"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toBottomOf="@id/searchBarContainer"
        app:layout_constraintStart_toStartOf="@id/searchBarContainer"
        app:layout_constraintEnd_toEndOf="@id/searchBarContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
