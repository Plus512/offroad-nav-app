<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/desert_brown"
        android:textColor="@color/white"
        android:padding="8dp"
        android:text="@string/locating"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="RtlHardcoded" />

    <TextView
        android:id="@+id/attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#88000000"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:padding="4dp"
        android:text="@string/map_attribution"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- زر القائمة/الإعدادات أسفل يسار الشاشة. هامش سفلي أكبر من المعتاد (٤٠dp) كي لا يتداخل مع
         شريط إسناد الخريطة (attribution) الملاصق لحافة الشاشة السفلية في نفس الزاوية. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="40dp"
        android:contentDescription="@string/menu_settings"
        app:srcCompat="@drawable/ic_menu_hamburger"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        tools:ignore="RtlHardcoded" />

    <!-- زر إنهاء الرحلة النشطة: مخفي افتراضياً، يظهر فقط بعد اختيار وجهة وبدء الملاحة. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabEndTrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:contentDescription="@string/end_trip"
        app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        tools:ignore="RtlHardcoded" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabLocate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="110dp"
        android:contentDescription="@string/locating"
        app:srcCompat="@android:drawable/ic_menu_mylocation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:ignore="RtlHardcoded" />

    <!-- بوصلة مخصّصة أعلى يمين الشاشة: تحل محل بوصلة المكتبة الجاهزة لأنها تحتاج التحكم الكامل
         بزاويتها (شمال افتراضياً، أو اتجاه الوجهة المختارة فعلياً) وبحدث ضغط خاص بها. -->
    <com.alruwaili.dalilalbar.CompassArrowView
        android:id="@+id/compassArrow"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:contentDescription="@string/compass_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:ignore="RtlHardcoded" />

    <!-- أيقونة تسجيل المسار على يمين الشاشة -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabTrackRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginTop="96dp"
        android:contentDescription="@string/track_record"
        app:srcCompat="@android:drawable/ic_menu_edit"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:ignore="RtlHardcoded" />

    <!-- لوحة البوصلة السفلية لوضع الشاشة المنقسمة؛ مخفية افتراضياً، تظهر عند الضغط على سهم البوصلة
         بعد اختيار وجهة. تُغطّي النصف السفلي من الشاشة فوق الخريطة (التي تبقى كاملة خلفها). -->
    <com.alruwaili.dalilalbar.CompassPanelView
        android:id="@+id/compassPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- زر رجوع/إغلاق صريح داخل لوحة البوصلة نفسها (أعلى يسارها)، بدل الاعتماد فقط على إعادة الضغط
         على سهم البوصلة العلوي. مخفي/ظاهر بنفس حالة ظهور اللوحة. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCloseCompassPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:contentDescription="@string/close_compass_panel"
        app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintTop_toTopOf="@id/compassPanel"
        app:layout_constraintLeft_toLeftOf="@id/compassPanel"
        tools:ignore="RtlHardcoded" />

</androidx.constraintlayout.widget.ConstraintLayout>
