<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/tools"
    android:layout_margin="8dp"
    card_view:cardBackgroundColor="#1F1A16"
    card_view:cardCornerRadius="15dp"
    card_view:cardElevation="16dp"
    app:ignore="NamespaceTypo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:background="#1F1A16"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- أيقونة القلب على اليمين -->
        <ImageView
            android:id="@+id/favoriteIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/favorite_border"
            app:tint="#FFDDA01E" />

        <!-- الاسم والمسافة بالترتيب عمودي -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اسم الموقع"
                android:textSize="18sp"
                android:textColor="#FF39FF6A"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/distanceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="428.089 كم"
                android:textSize="14sp"
                android:textColor="#FFC9BFB4"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- سهم الاتجاه: يفتح البوصلة الكاملة نحو هذا الموقع، مدوَّر بزاوية الاتجاه
             الحقيقية المحسوبة من موقع المستخدم الحالي -->
        <ImageView
            android:id="@+id/compassArrow"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:padding="4dp"
            android:src="@drawable/ic_navigation_arrow"
            android:contentDescription="فتح البوصلة نحو هذا الموقع" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
