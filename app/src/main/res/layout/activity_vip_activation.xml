<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sandy_gradient"
    android:layoutDirection="rtl"
    android:padding="20dp">

    <!-- App Logo (circular crop with border) -->
    <FrameLayout
        android:id="@+id/logoContainer"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_circle_border"
        android:padding="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/final_app_icon_removebg"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name"
            app:shapeAppearanceOverlay="@style/CircleImageStyle" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vip_activation_title"
        android:textColor="@color/vip_green"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/logoContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- STATE A: Input Form Container -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Phone input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:gravity="center">

            <!-- Country Code Spinner (RIGHT in RTL) -->
            <Spinner
                android:id="@+id/spinnerCountryCode"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_gray_input"
                android:spinnerMode="dropdown" />

            <!-- Phone Number EditText (LEFT in RTL) -->
            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="3"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_rounded_gray_input"
                android:hint="@string/vip_phone_hint"
                android:inputType="phone"
                android:digits="0123456789+"
                android:maxLength="15"
                android:textSize="16sp"
                android:textColorHint="@color/dark_neutral_gray"
                android:gravity="center"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Submit Button -->
        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rounded_black_btn"
            android:text="@string/vip_activation_submit"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- STATE B: Pending Container -->
    <LinearLayout
        android:id="@+id/pendingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Loading Spinner (shown during initial check) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Status Text -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vip_activation_pending"
            android:textColor="@color/pending_text_gray"
            android:textSize="16sp"
            android:gravity="center" />

        <!-- Email Button -->
        <TextView
            android:id="@+id/btnEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_rounded_green_btn"
            android:text="@string/vip_activation_email"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingRight="@dimen/padding_8dp"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <!-- Edit Number Button -->
        <TextView
            android:id="@+id/btnEditNumber"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_gray_btn"
            android:text="@string/vip_activation_edit"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            android:drawablePadding="8dp"
            android:paddingStart="8dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            app:drawableStartCompat="@drawable/ic_edit" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
